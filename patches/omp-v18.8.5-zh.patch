+/** Terminal-only artifact recovery hint; model output keeps its original wording. */
+export function formatFullOutputDisplayReference(artifactId: string, artifactElidedBytes?: number): string {
+	if (artifactElidedBytes !== undefined && artifactElidedBytes > 0) {
+		return `读取 artifact://${artifactId} 查看输出的首尾样本；中间 ${formatBytes(artifactElidedBytes)} 未保存`;
+	}
+	return `读取 artifact://${artifactId} 查看完整输出`;
+}
+
+/** Terminal-only truncation ranges and recovery hints. */
+export function formatTruncationMetaDisplayNotice(truncation: TruncationMeta, source?: SourceMeta): string {
+	const artifactReference = truncation.artifactId == null
+		? undefined
+		: source?.type === "report"
+			? `读取 artifact://${truncation.artifactId} 查看完整报告（${source.value}）`
+			: formatFullOutputDisplayReference(truncation.artifactId, truncation.artifactElidedBytes);
+	let notice: string;
+	if (truncation.direction === "middle") {
+		const head = truncation.headRange;
+		const tail = truncation.tailRange;
+		const elidedBytes = truncation.elidedBytes ?? Math.max(0, truncation.totalBytes - truncation.outputBytes);
+		const elidedLines = truncation.elidedLines ?? Math.max(0, truncation.totalLines - truncation.outputLines);
+		if (head && tail) {
+			notice = `显示第 ${head.start}-${head.end} 和 ${tail.start}-${tail.end} 行，共 ${truncation.totalLines} 行；省略中间 ${elidedLines.toLocaleString()} 行（${formatBytes(elidedBytes)}）`;
+		} else if (elidedBytes > 0) {
+			notice = `显示 ${truncation.totalLines.toLocaleString()} 行的首尾字节；省略 ${formatBytes(elidedBytes)}`;
+		} else {
+			notice = `显示 ${Math.min(truncation.outputLines, truncation.totalLines)}/${truncation.totalLines} 行；中间已省略`;
+		}
+	} else if (truncation.partialLine) {
+		const line = truncation.shownRange?.start ?? 1;
+		notice = `显示第 ${line} 行（部分，${formatBytes(truncation.outputBytes)}/${formatBytes(truncation.totalBytes)}），共 ${truncation.totalLines} 行`;
+	} else {
+		const range = truncation.shownRange;
+		notice = range && range.end >= range.start
+			? `显示第 ${range.start}-${range.end} 行，共 ${truncation.totalLines} 行`
+			: `显示 ${truncation.outputLines}/${truncation.totalLines} 行`;
+		if (truncation.truncatedBy === "bytes") {
+			notice += `（上限 ${formatBytes(truncation.maxBytes ?? truncation.outputBytes)}）`;
+		}
+	}
+	if ((truncation.direction === "middle" || !truncation.partialLine) && truncation.nextOffset != null) notice += `。使用 :${truncation.nextOffset} 继续`;
+	if (artifactReference) notice += `。${artifactReference}`;
+	return notice;
+}
