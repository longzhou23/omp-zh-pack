+/** Localize display details without changing the JSON command result. */
+function humanDetail(detail: string): string {
+	const messages: Record<string, string> = {
+		"Malformed provider file cache index": "提供商文件缓存索引格式错误",
+		"Unsupported provider file cache index": "不支持的提供商文件缓存索引",
+		"Image publication is enabled": "已启用图像发布",
+		"images.urls.enabled is false": "images.urls.enabled 为 false",
+		"No image publication backends are configured": "未配置任何图像发布后端",
+		"Required configuration is present": "所需配置已齐全",
+		"No OpenAI, Anthropic, or Google authentication is available": "没有可用的 OpenAI、Anthropic 或 Google 身份验证凭据",
+		"Provider authentication storage could not be inspected": "无法检查提供商身份验证存储",
+		"Image daemon is stopped or unreachable": "图像守护进程已停止或无法连接",
+		"No URL backend is configured": "未配置 URL 后端",
+		"Image publication is disabled": "已禁用图像发布",
+		"Image daemon could not be started or reached": "无法启动或连接图像守护进程",
+		"--timeout must be a positive integer": "--timeout 必须是正整数",
+	};
+	if (messages[detail]) return messages[detail];
+	for (const [prefix, translated] of [
+		["Missing required fields: ", "缺少必填字段："],
+		["Cache directory is readable and writable: ", "缓存目录可读写："],
+		["Cache directory is absent or not writable: ", "缓存目录不存在或不可写："],
+		["Authentication is available for: ", "以下提供商具有可用的身份验证凭据："],
+	]) {
+		if (detail.startsWith(prefix)) return translated + detail.slice(prefix.length);
+	}
+	if (detail.endsWith(" is available")) return `${detail.slice(0, -" is available".length)} 可用`;
+	if (detail.endsWith(" is not on PATH")) return `${detail.slice(0, -" is not on PATH".length)} 不在 PATH 中`;
+	return detail;
+}
